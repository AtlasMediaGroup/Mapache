{{!< default}}

{{#post}}
    <article class="post container mx-auto my-8">
        <h1 class="post-title text-4xl md:text-44 mb-5 text-title text-center mx-auto max-w-3xl">{{title}}</h1>
        {{> "article/article-media"}}
        <div class="post-body-wrap relative mx-auto max-w-3xl">
            <div class="post-body">
                {{content}}
            </div>
        </div>
    </article>
{{/post}}
            &copy; {{date format="YYYY"}} <a href="{{@site.url}}">{{@site.title}}</a>
            Design with ♥ by <a href="https://godofredo.ninja" aria-label="Design with love by GodoFredo">GodoFredo</a>
        </section>
    </footer>

    {{amp_analytics}}
</body>
</html>