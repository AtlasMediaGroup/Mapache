<div class="post-authors my-10">
    {{#foreach authors}}
    <div class="flex flex-col md:flex-row items-center p-7 rounded bg-gray-90 {{#unless @first}}mt-5{{/unless}}">
        <a href="{{url}}"  class="flex-none h-24 w-24 overflow-hidden relative rounded-full shadow-lg">
            <img class="image-inset absolute blur-up lazyload"
            src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
            data-src="{{#if profile_image}}{{img_url profile_image size="s"}}{{else}}{{asset "images/avatar.png"}}{{/if}}"
            alt="{{name}}"/>
        </a>

        <div class="mt-4 text-center md:ml-5 md:mt-0 md:text-left">
            <h2 class="text-xl text-title"><a class="hover:text-primary" href="{{url}}">{{name}}</a></h2>
            {{#if bio}}<p class="mt-2 lineClamp-2 text-gray-700">{{bio}}</p>{{/if}}
            <div class="mt-2 text-title">
                {{#if facebook}}
                <a class="mr-2 hover:text-facebook"
                    href="{{social_url type='facebook'}}"
                    title="Facebook"
                    target="_blank"
                    rel="noopener noreferrer">
                    <svg class="icon is-small"><use xlink:href="#icon-facebook"></use></svg>
                </a>
                {{/if}}

                {{#if twitter}}
                <a class="mr-2 hover:text-twitter"
                    href="{{social_url type='twitter'}}"
                    title="{{twitter}}"
                    target="_blank"
                    rel="noopener noreferrer">
                    <svg class="icon is-small"><use xlink:href="#icon-twitter"></use></svg>
                </a>
                {{/if}}

                {{#if mastodon}}
                <a class="mr-2 hover:text-gray-700"
                    href="{{mastodon}}"
                    title="Mastodon"
                    target="_blank"
                    rel="noopener noreferrer">
                    <svg class="icon is-small" viewBox="0 0 24 24"><path fill="currentColor" d="M23.268 5.313c.35-2.467.34-4.661.404-6.769-1.891.213-4.467.881-7.458 2.167.289-.113.635-.243.635-.243-2.759-.079-5.23 1.95-6.514 2.23C5.937 4.913 1.439 3.888 0 5.313c-.547 9.266.518 17.053 5.541 18.588 2.577.933 5.079 1.71 7.617 1.498 2.550-.212 4.457-1.287 4.457-1.287l-.08-1.812c1.679-1.646 2.764-4.311 2.764-6.92-.026-58.mediumless.com-1.871.104-3.622.403-5.330-1.299Z"/></svg>
                </a>
                {{/if}}

                {{#if website}}
                <a class="hover:text-gray-900"
                    href="{{website}}"
                    title="{{website}}"
                    target="_blank"
                    rel="noopener noreferrer">
                    <svg class="icon is-small is-stroke"><use xlink:href="#icon-link"></use></svg>
                </a>
                {{/if}}
            </div>
        </div>
    </div>
    {{/foreach}}
</div>